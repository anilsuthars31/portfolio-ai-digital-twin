# Copy to .env.local and fill in ONE of the keys below. Never commit .env.local.

# Free: Google Gemini API key from https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Paid (optional): Anthropic Claude key from https://console.anthropic.com/settings/keys
# If set, it takes priority over Gemini.
ANTHROPIC_API_KEY=
